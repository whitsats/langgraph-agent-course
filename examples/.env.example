[TEMPLATE]
# 复制成 .env 再填值：cp .env.example .env
#
# 只填这一行就够了（Agnes 免费额度）：
AGNES_API_KEY=sk-xxxxxxxxxxxxxxxx

# ─────────────────────────────────────────────────────────────
# 以下全部可选。不填也能跑，默认就是 Agnes + agnes-2.5-flash
# ─────────────────────────────────────────────────────────────

# 换模型（文本模型清单，按官方文档）
#   agnes-2.5-flash      工具调用 + 多模态理解  ← 当前默认（2026-09-23 实测：普通调用 0.5–8s、工具调用 0.6s）
#   agnes-3.0-flash      官方定位：更强的 Agent 任务执行与工具编排
#                        ⚠️ 2026-09-23 实测：网关侧【整段无响应】——连接通、请求收下、一个字不回
#                        （非流式 / 流式 / 带不带 max_tokens 全部 15s+ 超时，连测 4 次）
#   agnes-2.5-pro        高级推理、长上下文分析
#                        ⚠️ 免费额度下直接返回 403（无权限），不是你的配置问题
#   agnes-2.5-pro-beta   同上（Beta）
# MODEL=agnes-2.5-flash

# 换网关 / 换 Key（不填就用 Agnes 官方地址）
# MODEL_BASE_URL=https://api.agnes-ai.cn/v1
# MODEL_API_KEY=sk-xxxxxxxxxxxxxxxx

# 想用别家（OpenAI 官方）时，把上面两行注释掉，改用：
# MODEL=openai:gpt-4o
# 注：OPENAI_API_KEY 也会被当作 embedding 的 Key（见下面 RAG 那段）
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx

# ── RAG 用：embedding 是【另一条供应链】─────────────────────
# ⚠️ Agnes 官方文档列出的端点只有 chat/completions、responses、messages、
#    images/generations、videos —— 没有 /embeddings，模型清单里也没有 embedding 模型。
#    所以 Agnes 的 Key 算不了向量，RAG 必须另找一家。
#
# 不填：09_rag_agent.py 会用假 embedding 跑通链路（结果无语义，只看流程）。
# 要真效果：找一家 OpenAI 兼容的 embedding（也可用本地 fastembed / Ollama）：
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_API_KEY=sk-xxxxxxxxxxxxxxxx

# ── 可选：打开可观测性（免费，强烈建议第一天就开）────────────────
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_xxxxxxxxxxxxxxxx

# ── 免费额度有速率上限 ────────────────────────────────────────
# 一口气连跑十几个例子会撞 429「您已达到免费用户的 API 速率限制」（不是代码错）。
# 实测等 20s 即恢复；run_all.py 已内置 20s/45s 自动重试与例子间 3s 间隔。
