  import time
  from fastapi import APIRouter, HTTPException, Request
  from pydantic import BaseModel, Field
  from database import get_connection
  from auth import hash_password, verify_password, create_session, get_user_from_token, delete_session
  router = APIRouter()
  USERNAME_RE = re.compile(r"^[a-zA-Z0-9_]{3,20}$")
  # In-memory rate limiter
  _rate_store = {}
  def _rate_limit(key: str, max_attempts: int, window: int) -> bool:
      now = int(time.time())
      window_start = now - window
      if key not in _rate_store:
          _rate_store[key] = []
      _rate_store[key] = [t for t in _rate_store[key] if t > window_start]
      if len(_rate_store[key]) >= max_attempts:
          return False
      _rate_store[key].append(now)
      return True
  class RegisterInput(BaseModel):
      username: str = Field(..., min_length=3, max_length=20)
      password: str = Field(..., min_length=6)
  class LoginInput(BaseModel):
      username: str
      password: str
  @router.post("/api/register")
  def register(body: RegisterInput, request: Request):
      ip = request.client.host
      if not _rate_limit(f"register:{ip}", 10, 60):
          raise HTTPException(status_code=429, detail="Too many attempts")
      if not USERNAME_RE.match(body.username):
          raise HTTPException(status_code=400, detail="Invalid username format")
      conn = get_connection()
      existing = conn.execute("SELECT id FROM users WHERE username = ?", (body.username,)).fetchone()
      if existing:
          raise HTTPException(status_code=409, detail="Username already taken")
      hashed = hash_password(body.password)
      cur = conn.execute("INSERT INTO users (username, password_hash) VALUES (?, ?)", (body.username, hashed))
      conn.commit()

      token = create_session(cur.lastrowid)
      return {"token": token, "user_id": cur.lastrowid, "username": body.username}
  @router.post("/api/login")
  def login(body: LoginInput, request: Request):
      ip = request.client.host
      if not _rate_limit(f"login:{ip}", 10, 60):
          raise HTTPException(status_code=429, detail="Too many attempts")
      conn = get_connection()
      row = conn.execute("SELECT id, username, password_hash FROM users WHERE username = ?",
  (body.username,)).fetchone()
      if not row or not verify_password(body.password, row["password_hash"]):
          raise HTTPException(status_code=401, detail="Invalid credentials")
      token = create_session(row["id"])
      return {"token": token, "user_id": row["id"], "username": row["username"]}
  @router.post("/api/logout")
  def logout(request: Request):
      auth = request.headers.get("Authorization", "")
      if not auth.startswith("Bearer "):
          raise HTTPException(status_code=401, detail="Missing token")
      token = auth[7:]
      user_id = get_user_from_token(token)
      if user_id is None:
          raise HTTPException(status_code=401, detail="Invalid or expired token")
      delete_session(token)
      return {"detail": "Logged out"}
