  import hashlib
  from fastapi import FastAPI, HTTPException, Header, Depends
  from pydantic import BaseModel, EmailStr, field_validator
  from passlib.hash import bcrypt
  from database import get_db, init_db
  app = FastAPI(title="QingDong API", version="1.0.0")
  MAX_CONTENT_LENGTH = 500
  TOKEN_BYTES = 64
  SUGGESTED_USER_IDS = [1, 2, 3, 4, 5]
  @app.on_event("startup")
  def on_startup():
      init_db()
  def get_current_user(token: str = Header(None, alias="Authorization")):
      if not token:
          raise HTTPException(status_code=401, detail="Missing auth token")
      token = token.replace("Token ", "")
      with get_db() as db:
          row = db.execute(
              "SELECT user_id FROM sessions WHERE token = ?", (token,)
          ).fetchone()
          if not row:
              raise HTTPException(status_code=401, detail="Invalid or expired token")
          user = db.execute(
              "SELECT id, nickname, email, bio, created_at FROM users WHERE id = ?",
              (row["user_id"],),
          ).fetchone()
          if not user:
              raise HTTPException(status_code=401, detail="User not found")
          return dict(user)
  @app.get("/health")
  def health():
      return {"status": "ok"}
  class RegisterRequest(BaseModel):
      nickname: str
      email: str
      password: str
      @field_validator("nickname")
      @classmethod
      def nickname_not_empty(cls, v):
          v = v.strip()
          if not v:
              raise ValueError("Nickname is required")
          if len(v) > 50:
              raise ValueError("Nickname too long")
          return v
      @field_validator("email")
      @classmethod
      def email_valid(cls, v):
          v = v.strip().lower()
          if "@" not in v or "." not in v:
              raise ValueError("Invalid email")
          return v
      @field_validator("password")
      @classmethod
      def password_valid(cls, v):
          if len(v) < 6:
              raise ValueError("Password must be at least 6 characters")
          return v
  class LoginRequest(BaseModel):
      email: str
      password: str
  class PostCreateRequest(BaseModel):
      content: str
      @field_validator("content")
      @classmethod
      def content_length(cls, v):
          v = v.strip()
          if not v:
              raise ValueError("Content is required")
          if len(v) > MAX_CONTENT_LENGTH:
              raise ValueError(f"Content exceeds {MAX_CONTENT_LENGTH} characters")
          return v
  def make_token():
      return secrets.token_hex(TOKEN_BYTES)
  def user_to_dict(row, is_following=False):
      return {
          "id": row["id"],
          "nickname": row["nickname"],
          "email": row["email"],
          "bio": row["bio"] or "",
          "created_at": row["created_at"],
          "is_following": is_following,
      }
  def post_to_dict(row, author=None):
      return {
          "id": row["id"],
          "user_id": row["user_id"],
          "content": row["content"],
          "created_at": row["created_at"],
          "author": author,
      }
  @app.post("/api/auth/register")
  def register(req: RegisterRequest):
      email = req.email.strip().lower()
      password_hash = bcrypt.hash(req.password)
      with get_db() as db:
          existing = db.execute(
              "SELECT id FROM users WHERE email = ?", (email,)
          ).fetchone()
          if existing:
              raise HTTPException(status_code=409, detail="Email already registered")
          cur = db.execute(
              "INSERT INTO users (nickname, email, password_hash) VALUES (?, ?, ?)",
              (req.nickname.strip(), email, password_hash),
          )
          user_id = cur.lastrowid
          token = make_token()
          db.execute("INSERT INTO sessions (token, user_id) VALUES (?, ?)", (token, user_id))
          user = db.execute(
              "SELECT id, nickname, email, bio, created_at FROM users WHERE id = ?",
              (user_id,),
          ).fetchone()
      return {"token": token, "user": user_to_dict(user)}
  @app.post("/api/auth/login")
  def login(req: LoginRequest):
      email = req.email.strip().lower()
      with get_db() as db:
          user = db.execute(
              "SELECT id, nickname, email, bio, password_hash, created_at FROM users WHERE email = ?",
              (email,),
          ).fetchone()
          if not user or not bcrypt.verify(req.password, user["password_hash"]):
              raise HTTPException(status_code=401, detail="Invalid email or password")
          token = make_token()
          db.execute("INSERT INTO sessions (token, user_id) VALUES (?, ?)", (token, user["id"]))
      return {"token": token, "user": user_to_dict(user)}
  @app.post("/api/auth/logout")
  def logout(current_user: dict = Depends(get_current_user), authorization: str = Header(None)):
      token = authorization.replace("Token ", "")
      with get_db() as db:
          db.execute("DELETE FROM sessions WHERE token = ?", (token,))
      return {}
  @app.post("/api/posts")
  def create_post(req: PostCreateRequest, current_user: dict = Depends(get_current_user)):
      content = req.content.strip()
      with get_db() as db:
          cur = db.execute(
              "INSERT INTO posts (user_id, content) VALUES (?, ?)",
              (current_user["id"], content),
          )
          post = db.execute(
              "SELECT id, user_id, content, created_at FROM posts WHERE id = ?",
              (cur.lastrowid,),
          ).fetchone()
      return {"post": post_to_dict(post, author=current_user)}
  @app.get("/api/posts/feed")
  def get_feed(cursor: str = None, limit: int = 20, current_user: dict = Depends(get_current_user)):
      limit = min(max(limit, 1), 50)
      with get_db() as db:
          if cursor:
              posts = db.execute(
                  """SELECT p.id, p.user_id, p.content, p.created_at,
                            u.nickname, u.email, u.bio, u.created_at as u_created_at
                     FROM posts p
                     JOIN follows f ON f.followee_id = p.user_id
                     JOIN users u ON u.id = p.user_id
                     WHERE f.follower_id = ? AND p.created_at < ?
                     ORDER BY p.created_at DESC
                     LIMIT ?""",
                  (current_user["id"], cursor, limit + 1),
              ).fetchall()
          else:
              posts = db.execute(
                  """SELECT p.id, p.user_id, p.content, p.created_at,
                            u.nickname, u.email, u.bio, u.created_at as u_created_at
                     FROM posts p
                     JOIN follows f ON f.followee_id = p.user_id
                     JOIN users u ON u.id = p.user_id
                     WHERE f.follower_id = ?
                     ORDER BY p.created_at DESC
                     LIMIT ?""",
                  (current_user["id"], limit + 1),
              ).fetchall()
      result = []
      next_cursor = None
      for i, row in enumerate(posts):
          if i == limit:
              next_cursor = row["created_at"]
              break
          author = {
              "id": row["user_id"],
              "nickname": row["nickname"],
              "email": row["email"],
              "bio": row["bio"] or "",
              "created_at": row["u_created_at"],
          }
          result.append(post_to_dict(row, author=author))
      return {"posts": result, "next_cursor": next_cursor}
  @app.get("/api/posts/{post_id}")
  def get_post(post_id: int):
      with get_db() as db:
          row = db.execute(
              """SELECT p.id, p.user_id, p.content, p.created_at,
                        u.nickname, u.email, u.bio, u.created_at as u_created_at
                 FROM posts p
                 JOIN users u ON u.id = p.user_id
                 WHERE p.id = ?""",
              (post_id,),
          ).fetchone()
          if not row:
              raise HTTPException(status_code=404, detail="Post not found")
          author = {
              "id": row["user_id"],
              "nickname": row["nickname"],
              "email": row["email"],
              "bio": row["bio"] or "",
              "created_at": row["u_created_at"],
          }
      return {"post": post_to_dict(row, author=author)}
  @app.delete("/api/posts/{post_id}")
  def delete_post(post_id: int, current_user: dict = Depends(get_current_user)):
      with get_db() as db:
          post = db.execute(
              "SELECT id, user_id FROM posts WHERE id = ?", (post_id,)
          ).fetchone()
          if not post:
              raise HTTPException(status_code=404, detail="Post not found")
          if post["user_id"] != current_user["id"]:
              raise HTTPException(status_code=403, detail="Not your post")
          db.execute("DELETE FROM posts WHERE id = ?", (post_id,))
      return {}
