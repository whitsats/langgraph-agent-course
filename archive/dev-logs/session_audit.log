  ### `mvp_project/backend/app/routes.py`
  ```python
  from fastapi import APIRouter, Depends, HTTPException, Header
  from sqlalchemy.orm import Session
  from sqlalchemy import desc
  from app.database import get_db
  from app.models import User, Post, Session as UserSession
  from app.schemas import (
      RegisterRequest, LoginRequest, PostCreate,
      UserResponse, PostResponse, PostListResponse, MessageResponse,
  )
  from app.utils import hash_password, verify_password, generate_token, get_expiry
  from datetime import datetime, timezone
  router = APIRouter(prefix="/api")
  def get_current_user(token: str = Header(None, alias="Authorization"), db: Session = Depends(get_db)):
      if not token:
          raise HTTPException(status_code=401, detail="Not authenticated")
      if token.startswith("Bearer "):
          token = token[7:]
      session = db.query(UserSession).filter(
          UserSession.token == token,
          UserSession.expires_at > datetime.now(timezone.utc),
      ).first()
      if not session:
          raise HTTPException(status_code=401, detail="Invalid or expired token")
      user = db.query(User).filter(User.id == session.user_id).first()
      if not user:
          raise HTTPException(status_code=401, detail="User not found")
      return user
  @router.post("/register", response_model=UserResponse, status_code=201)
  def register(req: RegisterRequest, db: Session = Depends(get_db)):
      existing = db.query(User).filter(User.username == req.username).first()
      if existing:
          raise HTTPException(status_code=409, detail="Username already exists")
      user = User(
          username=req.username,
          password_hash=hash_password(req.password),
      )
      db.add(user)
      db.flush()
      token_str = generate_token()
      session = UserSession(
          user_id=user.id,
          token=token_str,
          expires_at=get_expiry(),
      )
      db.add(session)
      db.commit()
      return UserResponse(id=user.id, username=user.username, token=token_str)
  @router.post("/login", response_model=UserResponse)
  def login(req: LoginRequest, db: Session = Depends(get_db)):
      user = db.query(User).filter(User.username == req.username).first()
      if not user or not verify_password(req.password, user.password_hash):
          raise HTTPException(status_code=401, detail="Invalid credentials")
      token_str = generate_token()
      session = UserSession(
          user_id=user.id,
          token=token_str,
          expires_at=get_expiry(),
      )
      db.add(session)
      db.commit()
      return UserResponse(id=user.id, username=user.username, token=token_str)
  @router.post("/logout", response_model=MessageResponse)
  def logout(token: str = Header(None, alias="Authorization"), db: Session = Depends(get_db)):
      if not token:
          raise HTTPException(status_code=401, detail="Not authenticated")
      if token.startswith("Bearer "):
          token = token[7:]
      session = db.query(UserSession).filter(UserSession.token == token).first()
      if session:
          db.delete(session)
          db.commit()
      return MessageResponse(detail="Logged out")
  @router.get("/posts", response_model=PostListResponse)
  def get_posts(page: int = 1, size: int = 20, db: Session = Depends(get_db)):
      if size > 50:
          size = 50
      if page < 1:
          page = 1
      total = db.query(Post).count()
      offset_val = (page - 1) * size
      posts = (
          db.query(Post)
          .order_by(desc(Post.created_at))
          .offset(offset_val)
          .limit(size)
          .all()
      )
      result = []
      for p in posts:
          user = db.query(User).filter(User.id == p.user_id).first()
          result.append(PostResponse(
              id=p.id,
              username=user.username if user else "unknown",
              content=p.content,
              created_at=p.created_at.isoformat() if p.created_at else "",
          ))
      return PostListResponse(posts=result, page=page, size=size, total=total)
  @router.post("/posts", response_model=PostResponse, status_code=201)
  def create_post(req: PostCreate, db: Session = Depends(get_db),
                  current_user: User = Depends(get_current_user)):
      post = Post(user_id=current_user.id, content=req.content)
      db.add(post)
      db.commit()
      db.refresh(post)
      return PostResponse(
          id=post.id,
          username=current_user.username,
          content=post.content,
          created_at=post.created_at.isoformat() if post.created_at else "",
      )
  ```
