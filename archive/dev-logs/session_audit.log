      volumes:
        - ./backend/data:/app/data
      healthcheck:
        test: ["CMD-SHELL", "curl --fail http://localhost:8000/health || exit 1"]
        interval: 5s
        timeout: 3s
        retries: 5
        start_period: 10s
      restart: unless-stopped
    frontend:
      build:
        context: ./frontend
        dockerfile: Dockerfile
      ports:
        - "80:80"
      depends_on:
        backend:
          condition: service_healthy
      restart: unless-stopped
