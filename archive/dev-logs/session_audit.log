  @app.get("/api/users/{user_id}")
  def get_user_profile(user_id: int, current_user: dict = Depends(get_current_user)):
      with get_db() as db:
          user = db.execute(
              "SELECT id, nickname, email, bio, created_at FROM users WHERE id = ?",
              (user_id,),
