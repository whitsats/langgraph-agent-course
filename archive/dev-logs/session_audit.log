  import secrets
  import time
  from database import get_connection
  COST_FACTOR = 12
  SESSION_EXPIRY = 86400  # 24 hours
  def hash_password(password: str) -> str:
      return bcrypt.hashpw(password.encode("utf-8"), bcrypt.gensalt(COST_FACTOR)).decode("utf-8")
  def verify_password(password: str, hashed: str) -> bool:
      return bcrypt.checkpw(password.encode("utf-8"), hashed.encode("utf-8"))
  def create_session(user_id: int) -> str:
      token = secrets.token_hex(32)
      conn = get_connection()
      conn.execute(
          "INSERT INTO sessions (user_id, token, created_at) VALUES (?, ?, ?)",
          (user_id, token, int(time.time())),
      )
      conn.commit()
      return token
  def get_user_from_token(token: str):
      conn = get_connection()
      row = conn.execute(
          "SELECT user_id FROM sessions WHERE token = ? AND created_at > ?",
          (token, int(time.time()) - SESSION_EXPIRY),
      ).fetchone()
      if row is None:
          return None
      return row["user_id"]
  def delete_session(token: str):
      conn = get_connection()
      conn.execute("DELETE FROM sessions WHERE token = ?", (token,))
      conn.commit()
  def init_sessions_table():
      conn = get_connection()
      conn.execute("""
          CREATE TABLE IF NOT EXISTS sessions (
              id INTEGER PRIMARY KEY AUTOINCREMENT,
              user_id INTEGER NOT NULL,
              token TEXT UNIQUE NOT NULL,
              created_at INTEGER NOT NULL,
              FOREIGN KEY (user_id) REFERENCES users(id)
          )
      """)
      conn.commit()




