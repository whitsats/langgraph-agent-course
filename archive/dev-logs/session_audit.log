      posts = db.query(Post).filter(Post.author_id.in_(followed_ids)).order_by(desc(Post.created_at)).offset((page - 1) *
  PAGE_SIZE).limit(PAGE_SIZE).all()
      total = db.query(Post).filter(Post.author_id.in_(followed_ids)).count()
      has_more = (page * PAGE_SIZE) < total
      return {
