        desc = f"[{result}] {name}: status={status} (expected {expected_status}), body={body_raw[:200]}"
        if msg:
            desc += f" | Issues: {msg}"
        print(desc)
        results.append((name, result))

    except Exception as e:
        FAIL += 1
        print(f"[FAIL] {name}: UNEXPECTED ERROR - {str(e)}")
        traceback.print_exc()
        results.append((name, "FAIL"))

