      if body:
          data = json.dumps(body).encode("utf-8")
      headers = {"Content-Type": "application/json"}

      if token:
          headers["Authorization"] = f"Bearer {token}"
      req_obj = urllib.request.Request(url, data=data, headers=headers, method=method)
      try:
