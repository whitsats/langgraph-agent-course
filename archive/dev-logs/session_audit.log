BASE = "http://localhost:8000"
PASS = 0
FAIL = 0
TOTAL = 0
results = []

def test(name, expected_status, method="GET", path="/", body=None, headers=None, check_json=None, check_contains=None):
    global PASS, FAIL, TOTAL
    TOTAL += 1
    url = BASE + path
    data = None
    req_headers = {}

    if body is not None:
        data = json.dumps(body).encode("utf-8")
        req_headers["Content-Type"] = "application/json"

    if headers:
        req_headers.update(headers)

    try:
        req = urllib.request.Request(url, data=data, headers=req_headers, method=method)
        resp = urllib.request.urlopen(req, timeout=10)
        status = resp.status
        body_raw = resp.read().decode("utf-8")
        body_json = json.loads(body_raw) if body_raw else {}

        status_ok = status == expected_status
        check_ok = True
        msg = ""

        if check_json:
            for k, v in check_json.items():
                if k not in body_json:
                    check_ok = False
                    msg += f"Missing key '{k}'. "
                elif body_json[k] != v:
                    check_ok = False
                    msg += f"Key '{k}' expected '{v}', got '{body_json[k]}'. "

        if check_contains:
            for s in check_contains:
                if s not in body_raw:
                    check_ok = False
                    msg += f"Missing substring '{s}'. "

        if status_ok and check_ok:
            result = "PASS"
            PASS += 1
        else:
            result = "FAIL"
            FAIL += 1

        desc = f"[{result}] {name}: status={status} (expected {expected_status}), body={body_raw[:200]}"
        if msg:
            desc += f" | Issues: {msg}"
        print(desc)
        results.append((name, result))

    except urllib.error.HTTPError as e:
        status = e.code
        body_raw = e.read().decode("utf-8")
        body_json = {}
        try:
            body_json = json.loads(body_raw)
        except:
            pass

        status_ok = status == expected_status
        check_ok = True
        msg = ""

        if check_json:
            for k, v in check_json.items():
                if k not in body_json:
                    check_ok = False
                    msg += f"Missing key '{k}'. "
                elif body_json[k] != v:
                    check_ok = False
                    msg += f"Key '{k}' expected '{v}', got '{body_json[k]}'. "

        if check_contains:
            for s in check_contains:
                if s not in body_raw:
