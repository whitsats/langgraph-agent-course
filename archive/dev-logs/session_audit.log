  import time
  from fastapi import APIRouter, HTTPException, Request
  from pydantic import BaseModel, Field
  from database import get_connection
  from auth import get_user_from_token
  router = APIRouter()
  _rate_store = {}
  def _rate_limit(key: str, max_attempts: int, window: int) -> bool:
      now = int(time.time())
      window_start = now - window
      if key not in _rate_store:
          _rate_store[key] = []
      _rate_store[key] = [t for t in _rate_store[key] if t > window_start]
      if len(_rate_store[key]) >= max_attempts:
          return False
      _rate_store[key].append(now)
      return True
  class PostInput(BaseModel):
      content: str = Field(..., max_length=500)
  def _get_current_user(request: Request):
      auth = request.headers.get("Authorization", "")
      if not auth.startswith("Bearer "):
          return None
      token = auth[7:]
      return get_user_from_token(token)
  @router.get("/api/posts")
  def list_posts():
      conn = get_connection()
      rows = conn.execute("""
          SELECT p.id, p.content, p.created_at, p.user_id, u.username,
                 (SELECT COUNT(*) FROM likes WHERE post_id = p.id) AS like_count
          FROM posts p
          JOIN users u ON u.id = p.user_id
          ORDER BY p.created_at DESC
      """).fetchall()
      posts = []
      for r in rows:
          posts.append({
              "id": r["id"],
              "content": r["content"],

              "created_at": r["created_at"],
              "user_id": r["user_id"],
              "username": r["username"],
              "like_count": r["like_count"],
          })
      # Simple heat weighting: if a post has >= 5 more likes than the one above, bubble up
      changed = True
      while changed:
          changed = False
          for i in range(len(posts) - 1):
              if posts[i + 1]["like_count"] - posts[i]["like_count"] >= 5:
                  posts[i], posts[i + 1] = posts[i + 1], posts[i]
                  changed = True
      return posts
  @router.post("/api/posts")
  def create_post(body: PostInput, request: Request):
      user_id = _get_current_user(request)
      if user_id is None:
          raise HTTPException(status_code=401, detail="Authentication required")
      if not _rate_limit(f"post:{user_id}", 30, 3600):
          raise HTTPException(status_code=429, detail="Post rate limit exceeded")
      safe_content = html.escape(body.content.strip())
      if not safe_content:
          raise HTTPException(status_code=400, detail="Content cannot be empty")
      conn = get_connection()
      cur = conn.execute("INSERT INTO posts (user_id, content) VALUES (?, ?)", (user_id, safe_content))
      conn.commit()
      return {"id": cur.lastrowid, "content": safe_content, "user_id": user_id}
  @router.post("/api/posts/{post_id}/like")
  def like_post(post_id: int, request: Request):
      user_id = _get_current_user(request)
      if user_id is None:
          raise HTTPException(status_code=401, detail="Authentication required")
      if not _rate_limit(f"like:{user_id}", 60, 60):
          raise HTTPException(status_code=429, detail="Like rate limit exceeded")
      conn = get_connection()
      post = conn.execute("SELECT id FROM posts WHERE id = ?", (post_id,)).fetchone()
      if not post:
          raise HTTPException(status_code=404, detail="Post not found")
      existing = conn.execute("SELECT id FROM likes WHERE user_id = ? AND post_id = ?", (user_id,
  post_id)).fetchone()
      if existing:
          raise HTTPException(status_code=409, detail="Already liked")
      conn.execute("INSERT INTO likes (user_id, post_id) VALUES (?, ?)", (user_id, post_id))
      conn.commit()
      count = conn.execute("SELECT COUNT(*) as cnt FROM likes WHERE post_id = ?", (post_id,)).fetchone()["cnt"]
      return {"like_count": count}
  @router.delete("/api/posts/{post_id}/like")
  def unlike_post(post_id: int, request: Request):
      user_id = _get_current_user(request)
      if user_id is None:
          raise HTTPException(status_code=401, detail="Authentication required")
      conn = get_connection()
      post = conn.execute("SELECT id FROM posts WHERE id = ?", (post_id,)).fetchone()
      if not post:
          raise HTTPException(status_code=404, detail="Post not found")
      existing = conn.execute("SELECT id FROM likes WHERE user_id = ? AND post_id = ?", (user_id,
  post_id)).fetchone()
      if not existing:
          raise HTTPException(status_code=404, detail="Like not found")
      conn.execute("DELETE FROM likes WHERE user_id = ? AND post_id = ?", (user_id, post_id))
      conn.commit()
      count = conn.execute("SELECT COUNT(*) as cnt FROM likes WHERE post_id = ?", (post_id,)).fetchone()["cnt"]
      return {"like_count": count}
  @router.get("/health")
  def health():
      return {"status": "ok"}

