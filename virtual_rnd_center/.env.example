# 复制为 .env 并填入真实值（变量名以本目录 README 第 2 步的变量表为准）
# 换任何 OpenAI 兼容网关：改 OPENAI_API_BASE + DEEPSEEK_API_KEY + DEEPSEEK_MODEL 三个字段，
# 并同步改 utils/llm_factory.py 里的 provider 前缀（默认是 deepseek/）。
DEEPSEEK_API_KEY=
OPENAI_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro

# 可选
SERPER_API_KEY=
STREAM_THOUGHTS=false
# CREWAI_TRACING_ENABLED=false
# CREWAI_LOG_LEVEL=INFO
